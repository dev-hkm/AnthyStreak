<?xml version="1.0" encoding="utf-8"?>
<!-- Compact 2x1 card (118..175dp x 64..93dp): flame+count stacked left, goal+pill roomy on right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_shape_compact"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.82"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_flame_outer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_flame_outer" />

        <TextView
            android:id="@+id/widget_streak_count"
            style="@style/WidgetTextDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_count"
            android:textColor="@color/widget_text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/widget_streak_label"
            style="@style/WidgetTextMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_days"
            android:textColor="@color/widget_text_muted"
            android:textSize="6.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_detail_box"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1.38"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_eyebrow"
            style="@style/WidgetTextMeta"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_habit_name"
            style="@style/WidgetTextDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_goal"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_status"
            style="@style/WidgetTextMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_status"
            android:textColor="@color/widget_text_muted"
            android:textSize="7.5sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_task_progress"
            style="@style/WidgetTextMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="7.5sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_check_in"
            style="@style/WidgetTextDisplay"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_action_shape"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:text="@string/widget_preview_check_in"
            android:textColor="@color/widget_action_text"
            android:textSize="8.5sp" />
    </LinearLayout>
</LinearLayout>
