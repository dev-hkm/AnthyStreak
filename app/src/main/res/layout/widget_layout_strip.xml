<?xml version="1.0" encoding="utf-8"?>
<!-- 112 x 48dp: shallow ember hierarchy with direct flame interaction. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_shape"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="5dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp">
        <ImageView android:id="@+id/widget_flame_glow" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/widget_flame_glow" />
        <ImageView android:id="@+id/widget_flame_outer" android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_widget_flame_outer" />
        <ImageView android:id="@+id/widget_flame_mid" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_widget_flame_mid" />
        <ImageView android:id="@+id/widget_flame_inner" android:layout_width="21dp" android:layout_height="21dp" android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="3dp" android:contentDescription="@null" android:src="@drawable/ic_widget_flame_inner" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:gravity="center"
        android:orientation="vertical">
        <TextView android:id="@+id/widget_streak_count" style="@style/WidgetText" android:layout_width="46dp" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_preview_count" android:textColor="@color/widget_text_primary" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_streak_label" style="@style/WidgetText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:text="@string/widget_preview_days" android:textColor="@color/widget_text_muted" android:textSize="9sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/widget_eyebrow" style="@style/WidgetText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_habit_name" style="@style/WidgetText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_status" style="@style/WidgetText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_task_progress" style="@style/WidgetText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_check_in" style="@style/WidgetText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
</LinearLayout>
