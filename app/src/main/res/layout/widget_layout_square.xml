<?xml version="1.0" encoding="utf-8"?>
<!-- 112 x 168dp: tall editorial hierarchy for checklist or poster styles. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_shape"
    android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical">
        <TextView android:id="@+id/widget_eyebrow" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:letterSpacing="0.15" android:text="@string/widget_preview_today" android:textColor="@color/widget_text_muted" android:textSize="9sp" android:textStyle="bold" />
        <FrameLayout android:layout_width="68dp" android:layout_height="64dp" android:layout_marginTop="2dp">
            <ImageView android:id="@+id/widget_flame_glow" android:layout_width="66dp" android:layout_height="66dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/widget_flame_glow" />
            <ImageView android:id="@+id/widget_flame_outer" android:layout_width="59dp" android:layout_height="59dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_widget_flame_outer" />
            <ImageView android:id="@+id/widget_flame_mid" android:layout_width="45dp" android:layout_height="45dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_widget_flame_mid" />
            <ImageView android:id="@+id/widget_flame_inner" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="5dp" android:contentDescription="@null" android:src="@drawable/ic_widget_flame_inner" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/widget_streak_count" style="@style/WidgetText" android:layout_width="54dp" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="31sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_preview_count" android:textColor="@color/widget_text_primary" android:textSize="31sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_streak_label" style="@style/WidgetText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:text="@string/widget_preview_days" android:textColor="@color/widget_text_muted" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/widget_habit_name" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_preview_goal" android:textColor="@color/widget_text_primary" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_preview_status" android:textColor="@color/widget_text_muted" android:textSize="8sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_task_progress" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_text_muted" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/widget_check_in" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="27dp" android:layout_marginTop="5dp" android:background="@drawable/widget_action_shape" android:gravity="center" android:includeFontPadding="false" android:text="@string/widget_preview_check_in" android:textColor="@color/widget_action_text" android:textSize="9sp" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
