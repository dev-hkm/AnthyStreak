<?xml version="1.0" encoding="utf-8"?>
<!--
     Compatibility/default widget surface. The provider can select
     widget_layout_compact or widget_layout_expanded after it receives size
     options; all three layouts retain the same dynamic IDs.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_shape"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="82dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp">

                <ImageView
                    android:id="@+id/widget_flame_glow"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_flame_glow" />

                <ImageView
                    android:id="@+id/widget_flame_outer"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_flame_outer" />

                <ImageView
                    android:id="@+id/widget_flame_mid"
                    android:layout_width="49dp"
                    android:layout_height="49dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_flame_mid" />

                <ImageView
                    android:id="@+id/widget_flame_inner"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_flame_inner" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/WidgetText"
                    android:id="@+id/widget_streak_count"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="26sp"
                    android:autoSizeStepGranularity="1sp"
                    android:text="@string/widget_preview_count"
                    android:textColor="#171717"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/WidgetText"
                    android:id="@+id/widget_streak_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_days"
                    android:textColor="#696969"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetText"
                android:id="@+id/widget_eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:text="@string/widget_preview_today"
                android:textColor="#696969"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                style="@style/WidgetText"
                android:id="@+id/widget_habit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/widget_preview_goal"
                android:textColor="#171717"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                style="@style/WidgetText"
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_status"
                android:textColor="#696969"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                style="@style/WidgetText"
                android:id="@+id/widget_task_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#696969"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                style="@style/WidgetText"
                android:id="@+id/widget_check_in"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/widget_action_shape"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/widget_preview_check_in"
                android:textAllCaps="true"
                android:textColor="#FCFCFC"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
