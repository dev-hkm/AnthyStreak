<?xml version="1.0" encoding="utf-8"?>
<!-- Default/compatibility widget layout matching widget_layout_square. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_shape"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_flame_outer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_flame_outer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="0.95"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_streak_count"
                style="@style/WidgetTextDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_count"
                android:textColor="@color/widget_text_primary"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/widget_streak_label"
                style="@style/WidgetTextMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_days"
                android:textColor="@color/widget_text_muted"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_detail_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_eyebrow"
            style="@style/WidgetTextMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:text="@string/widget_preview_today"
            android:textColor="@color/widget_text_muted"
            android:textSize="8sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_habit_name"
            style="@style/WidgetTextDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_goal"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_status"
            style="@style/WidgetTextMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_status"
            android:textColor="@color/widget_text_muted"
            android:textSize="8.5sp" />

        <TextView
            android:id="@+id/widget_task_progress"
            style="@style/WidgetTextMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="8.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_check_in"
        style="@style/WidgetTextDisplay"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_action_shape"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:text="@string/widget_preview_check_in"
        android:textColor="@color/widget_action_text"
        android:textSize="9.5sp" />
</LinearLayout>
