<?xml version="1.0" encoding="utf-8"?>
<!-- 56 x 56dp: a single glanceable ember and its current count. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_shape"
    android:padding="5dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/widget_flame_glow"
            android:layout_width="39dp"
            android:layout_height="39dp"
            android:layout_gravity="center_horizontal|top"
            android:contentDescription="@null"
            android:src="@drawable/widget_flame_glow" />

        <ImageView
            android:id="@+id/widget_flame_outer"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="center_horizontal|top"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_flame_outer" />

        <ImageView
            android:id="@+id/widget_flame_inner"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="11dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_flame_inner" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_streak_count"
                style="@style/WidgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/widget_preview_count"
                android:textColor="@color/widget_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_streak_label"
                style="@style/WidgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:includeFontPadding="false"
                android:text="@string/widget_preview_days"
                android:textColor="@color/widget_text_muted"
                android:textSize="7sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <TextView android:id="@+id/widget_eyebrow" style="@style/WidgetText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_habit_name" style="@style/WidgetText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_status" style="@style/WidgetText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_task_progress" style="@style/WidgetText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_check_in" style="@style/WidgetText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
</FrameLayout>
