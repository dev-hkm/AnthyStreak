<?xml version="1.0" encoding="utf-8"?>
<!-- 240 x 88dp: horizontal focus/checklist dashboard. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_shape"
    android:padding="11dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="58dp" android:layout_height="58dp">
            <ImageView android:id="@+id/widget_flame_glow" android:layout_width="58dp" android:layout_height="58dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/widget_flame_glow" />
            <ImageView android:id="@+id/widget_flame_outer" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_widget_flame_outer" />
            <ImageView android:id="@+id/widget_flame_inner" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="5dp" android:contentDescription="@null" android:src="@drawable/ic_widget_flame_inner" />
        </FrameLayout>
        <LinearLayout android:layout_width="56dp" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                <TextView android:id="@+id/widget_streak_count" style="@style/WidgetText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/widget_preview_count" android:textColor="@color/widget_text_primary" android:textSize="29sp" android:textStyle="bold" />
                <TextView android:id="@+id/widget_streak_label" style="@style/WidgetText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:includeFontPadding="false" android:text="@string/widget_preview_days" android:textColor="@color/widget_text_muted" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="9dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/widget_eyebrow" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:letterSpacing="0.14" android:text="@string/widget_preview_today" android:textColor="@color/widget_text_muted" android:textSize="8sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_habit_name" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_preview_goal" android:textColor="@color/widget_text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_status" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_preview_status" android:textColor="@color/widget_text_muted" android:textSize="8sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_task_progress" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_text_muted" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/widget_check_in" style="@style/WidgetText" android:layout_width="72dp" android:layout_height="34dp" android:layout_marginStart="10dp" android:background="@drawable/widget_action_shape" android:gravity="center" android:includeFontPadding="false" android:text="@string/widget_preview_check_in" android:textColor="@color/widget_action_text" android:textSize="9sp" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
